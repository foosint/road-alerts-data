# Copy to .env and adjust. Real environment variables take precedence over this file.

# Feed to download on every run
ROADS_URL=https://example.org/roads.json

# 1 = commit data/ and push this repo whenever the data changes (set this on the Pi only)
PUBLISH=0
# Private key of the GitHub deploy key (write access) for this repo
PUBLISH_SSH_KEY=/home/pi/.ssh/road_alerts_data_deploy
# Commit author shown on GitHub
PUBLISH_GIT_NAME=road-alerts-data
PUBLISH_GIT_EMAIL=road-alerts-data@bot.invalid
